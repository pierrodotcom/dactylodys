		"enter": { "$value": "{easing.out}" },
		"exit": { "$value": "{easing.in}" }
	},
	"z-index": {
		"$type": "number",
		"base": { "$value": 0 },
		"raised": { "$value": 10 },
		"sticky": { "$value": 100 },
		"overlay": { "$value": 1000 },
		"modal": { "$value": 1100 },
		"toast": { "$value": 1200 }
