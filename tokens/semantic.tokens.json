		"panel-max": { "$value": "32rem" },
		"bubble-tail": { "$value": "{dimension.16}" },
		"star": { "$value": "2rem" },
		"visually-hidden": { "$value": "1px" }
	},
	"radius": {
		"$type": "dimension",
		"sm": { "$value": "{dimension.4}" },
		"md": { "$value": "{dimension.8}" },
		"lg": { "$value": "{dimension.16}" },
		"pill": { "$value": "9999px" }
	},
	"border-width": {
		"$type": "dimension",
		"thin": { "$value": "1px" },
		"thick": { "$value": "2px" },
		"focus": { "$value": "3px" },
		"target": { "$value": "4px" }
	},
	"scale": {
		"$type": "number",
		"target": { "$value": 1.12 },
		"press": { "$value": 0.97 }
	},
	"shadow": {
		"$type": "shadow",
		"sm": {
			"$value": {
				"color": "{color.shadow.light}",
				"offsetX": "0",
				"offsetY": "1px",
				"blur": "2px",
				"spread": "0"
			}
		},
		"md": {
			"$value": {
				"color": "{color.shadow.light}",
				"offsetX": "0",
				"offsetY": "4px",
				"blur": "12px",
				"spread": "0"
			}
		},
		"lg": {
			"$value": {
				"color": "{color.shadow.light}",
				"offsetX": "0",
				"offsetY": "12px",
				"blur": "32px",
				"spread": "0"
			}
		},
		"inset": {
			"$value": {
				"color": "{color.shadow.light}",
				"offsetX": "0",
				"offsetY": "2px",
				"blur": "4px",
				"spread": "0",
				"inset": true
			}
		}
	},
	"opacity": {
		"$type": "number",
		"disabled": { "$value": 0.5 },
		"overlay": { "$value": 0.6 }
	},
