{
	"color": {
		"$type": "color",
		"surface": {
			"base": { "$value": "{color.charcoal.800}" },
			"raised": { "$value": "{color.charcoal.700}" },
			"sunken": { "$value": "{color.charcoal.900}" }
		},
		"text": {
			"primary": { "$value": "{color.brown.50}" },
			"secondary": { "$value": "{color.brown.100}" },
			"on-accent": { "$value": "{color.charcoal.900}" }
		},
		"accent": {
			"base": { "$value": "{color.teal.400}" },
			"hover": { "$value": "{color.teal.300}" }
		},
		"border": {
			"subtle": { "$value": "{color.charcoal.600}" },
			"strong": { "$value": "{color.brown.400}" }
		},
		"focus": {
			"ring": { "$value": "{color.indigo.300}" }
		},
		"egg": {
			"shadow": { "$value": "{color.shadow.dark}" }
		},
		"success": {
			"text": { "$value": "{color.green.300}" },
			"surface": { "$value": "{color.green.900}" }
		},
		"error": {
			"text": { "$value": "{color.red.300}" },
			"surface": { "$value": "{color.red.900}" }
		},
		"key": {
			"surface": { "$value": "{color.charcoal.700}" },
			"border": { "$value": "{color.brown.400}" },
			"text": { "$value": "{color.brown.50}" },
			"target-outline": { "$value": "{color.brown.50}" }
		},
		"oops": {
			"outline": { "$value": "{color.amber.300}" }
		},
		"drawing": {
			"line": { "$value": "{color.brown.50}" },
			"paper": { "$value": "{color.brown.50}" },
			"desk": { "$value": "{color.charcoal.600}" },
			"desk-dark": { "$value": "{color.charcoal.700}" }
		},
		"silhouette": { "$value": "{color.brown.550}" },
		"reward": {
			"backdrop": { "$value": "{color.brown.100}" }
		},
		"hand": {
			"fill": { "$value": "{color.charcoal.700}" },
			"outline": { "$value": "{color.brown.50}" },
			"active": { "$value": "{color.teal.400}" }
		},
		"train": {
			"sky-high": { "$value": "{color.navy.800}" },
			"sky-low": { "$value": "{color.slate.600}" },
			"sun": { "$value": "{color.cream.200}" },
			"cloud": { "$value": "{color.slate.300}" },
			"hill-far": { "$value": "{color.sage.400}" },
			"hill-near": { "$value": "{color.jade.300}" }
		},
		"race": {
			"pole": { "$value": "{color.brown.100}" },
			"mark": { "$value": "{color.brown.50}" },
			"grass": { "$value": "{color.sage.400}" },
			"grass-line": { "$value": "{color.green.900}" }
		},
		"typing": {
			"done": { "$value": "{color.brown.400}" },
			"current-surface": { "$value": "{color.charcoal.700}" },
			"current-frame": { "$value": "{color.teal.400}" }
		},
		"recipe": {
			"sky": { "$value": "{color.navy.800}" },
			"sun": { "$value": "{color.cream.200}" }
		}
	},
	"shadow": {
		"$type": "shadow",
		"sm": {
			"$value": {
				"color": "{color.shadow.dark}",
				"offsetX": "0",
				"offsetY": "1px",
				"blur": "2px",
				"spread": "0"
			}
		},
		"md": {
			"$value": {
				"color": "{color.shadow.dark}",
				"offsetX": "0",
				"offsetY": "4px",
				"blur": "12px",
				"spread": "0"
			}
		},
		"lg": {
			"$value": {
				"color": "{color.shadow.dark}",
				"offsetX": "0",
				"offsetY": "12px",
				"blur": "32px",
				"spread": "0"
			}
		},
		"inset": {
			"$value": {
				"color": "{color.shadow.dark}",
				"offsetX": "0",
				"offsetY": "2px",
				"blur": "4px",
				"spread": "0",
				"inset": true
			}
		}
	},
	"opacity": {
		"$type": "number",
		"recipe-tile": { "$value": 0.05 },
		"recipe-shadow": { "$value": 0.4 }
	}
}
