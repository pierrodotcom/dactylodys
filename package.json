{
	"name": "dactylodys",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"tokens": "node tools/build-tokens.js",
		"i18n": "paraglide-js compile --project ./project.inlang --silent",
		"generate": "npm run -s tokens && npm run -s i18n",
		"predev": "npm run -s generate",
		"dev": "vite dev",
		"prebuild": "npm run -s generate",
		"build": "vite build",
		"preview": "vite preview",
		"precheck": "npm run -s generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"prelint": "npm run -s generate",
		"lint": "eslint . && stylelint \"**/*.{css,svelte}\" && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "npm run build && playwright test",
		"verify": "node tools/verify.js",
		"prepare": "node tools/install-hooks.js"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@eslint/js": "10.0.1",
		"@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
		"@inlang/paraglide-js": "2.27.0",
		"@inlang/plugin-message-format": "4.5.0",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"eslint": "10.12.0",
		"eslint-plugin-svelte": "3.23.1",
		"fast-check": "4.10.2",
		"globals": "17.13.0",
		"lefthook": "2.2.1",
		"postcss-html": "2.0.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"style-dictionary": "5.6.1",
		"stylelint": "17.16.0",
		"stylelint-declaration-strict-value": "1.12.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.1",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	}
}
